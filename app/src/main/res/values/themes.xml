<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight so the first frame matches the system theme: no white flash in dark mode. -->
    <style name="Theme.DevPhone" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
